---
import BaseLayout from "@theme/layouts/BaseLayout.astro";
import ontologies from "../data/ontology.json";
import { latestVersion } from "../lib/rewrites.js";
import site from "../site.js";

const page = {
    title: "Catram Ontologies",
    description: "Catram Ontology Collection.",
    lead: "A collection of ontologies maintained by Catram.",
    active: "ontology",
};

const entries = ontologies.map((ontology) => ({
    ...ontology,
    latest: latestVersion(ontology),
}));
---

<BaseLayout site={site} {...page}>
    <div class="container">
        <div class="row">
            {
                entries.map((ontology) => (
                    <div class="col-md-6">
                        <div class="card mb-4 shadow-sm">
                            <div class="card-header">
                                <h4 class="my-0 font-weight-normal">
                                    {ontology.title}
                                </h4>
                            </div>
                            <div class="card-body">
                                <p class="card-text">{ontology.description}</p>

                                <div class="d-flex justify-content-between align-items-center">
                                    <div class="btn-group">
                                        <a
                                            class="btn btn-primary"
                                            href={`/${ontology.latest.file}`}
                                        >
                                            Latest ({ontology.latest_version})
                                        </a>
                                        <button
                                            class="btn btn-outline-secondary dropdown-toggle"
                                            type="button"
                                            data-bs-toggle="dropdown"
                                            aria-expanded="false"
                                        >
                                            Other Versions
                                        </button>
                                        <ul class="dropdown-menu">
                                            {ontology.versions.map((version) => (
                                                <li>
                                                    <a
                                                        class="dropdown-item"
                                                        href={`/${version.file}`}
                                                    >
                                                        {version.version} (
                                                        {version.date})
                                                    </a>
                                                </li>
                                            ))}
                                        </ul>
                                    </div>
                                </div>

                                <div class="mt-3">
                                    <small class="text-muted">
                                        Versions: {ontology.versions.length}
                                    </small>
                                </div>
                            </div>
                        </div>
                    </div>
                ))
            }
        </div>
    </div>
</BaseLayout>
