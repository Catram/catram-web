{
    "name": "catram-web",
    "version": "0.0.0",
    "private": true,
    "type": "module",
    "engines": {
        "node": ">=22.23.4"
    },
    "scripts": {
        "build": "node build.js",
        "test": "vitest",
        "dev": "wrangler dev",
        "dev:catram": "astro dev --root sites/catram.org",
        "dev:ca": "astro dev --root sites/ca.catram.org",
        "dev:ontology": "astro dev --root sites/ontology.catram.org",
        "start": "npm run dev",
        "deploy": "wrangler deploy",
        "cf-typegen": "wrangler types"
    },
    "devDependencies": {
        "@cloudflare/vitest-pool-workers": "0.22.0",
        "@eslint/js": "10.0.1",
        "@eslint/json": "2.1.0",
        "@eslint/markdown": "8.0.3",
        "astro": "7.4.2",
        "eslint": "10.10.0",
        "globals": "17.12.0",
        "npm-check-updates": "23.1.0",
        "prettier": "3.9.7",
        "typescript": "6.0.3",
        "typescript-eslint": "8.70.0",
        "vitest": "4.1.11",
        "wrangler": "4.151.1"
    }
}
