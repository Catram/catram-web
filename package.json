{
    "name": "catram-web",
    "version": "0.0.0",
    "private": true,
    "type": "module",
    "engines": {
        "node": ">=22.23.4"
    },
    "scripts": {
        "build": "node build.js",
        "test": "vitest",
        "dev": "wrangler dev",
        "dev:catram": "astro dev --root sites/catram.org",
        "dev:ca": "astro dev --root sites/ca.catram.org",
        "dev:ontology": "astro dev --root sites/ontology.catram.org",
        "start": "npm run dev",
        "deploy": "wrangler deploy",
        "cf-typegen": "wrangler types"
    },
    "devDependencies": {
        "@cloudflare/vitest-plugin": "1.8.5",
        "@eslint/js": "10.0.1",
        "@eslint/json": "2.1.1",
        "@eslint/markdown": "9.0.0",
        "@types/node": "26.6.6",
        "astro": "7.4.13",
        "eslint": "10.15.0",
        "globals": "17.14.0",
        "npm-check-updates": "23.1.1",
        "prettier": "3.10.1",
        "typescript": "6.0.3",
        "typescript-eslint": "8.73.0",
        "vitest": "4.1.12",
        "wrangler": "4.164.0"
    }
}
